<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Link situs komik" android:textSize="20sp" android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tempel alamat situs komik di bawah (cukup halaman utamanya, misalnya https://namasitus.com), lalu tekan Simpan &amp; Cek.\n\nCukup diisi sekali — link tersimpan di aplikasi. Ganti hanya jika situs pindah domain atau Anda ingin memakai situs lain." />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:hint="https://…">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/url"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textUri" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:hint="API key (opsional, mis. nhk_...)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/apiKey"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPassword" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Simpan &amp; Cek" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Kalau muncul pesan verifikasi / Cloudflare, buka situsnya sekali di sini sampai tampil normal, lalu tekan Selesai." />
        <Button
            android:id="@+id/verify"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Verifikasi di browser" />
        <Button
            android:id="@+id/testImg"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Tes gambar" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Cache gambar" android:textSize="20sp" android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Gambar yang pernah dibuka disimpan supaya tidak diunduh ulang. Jika penuh, yang paling lama dihapus otomatis." />
        <TextView
            android:id="@+id/cacheUsage"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textStyle="bold" />
        <RadioGroup
            android:id="@+id/cacheSize"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:orientation="horizontal">
            <RadioButton
                android:id="@+id/cache200"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="200 MB" />
            <RadioButton
                android:id="@+id/cache500"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="500 MB" />
            <RadioButton
                android:id="@+id/cache1024"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="1 GB" />
        </RadioGroup>
        <Button
            android:id="@+id/clearCache"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Hapus cache gambar" />
    </LinearLayout>
</ScrollView>
